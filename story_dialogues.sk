# ==============================================================================
#              GENERATED STORY DIALOGUES & NPC ROUTER
#         Auto-generated by Story Studio Compiler. Do NOT edit manually.
# ==============================================================================

# Router utama ke skrip dialog karakter
function storyRouteNpcDialogue(p: player, npcName: text, loc: location):
	set {_uuid} to uuid of {_p}
	set {_waitedFin} to difference between {story::dialogue_finish_cooldown::%{_uuid}%} and now
	if {_waitedFin} is less than 1.5 seconds:
		stop
	
	if {_npcName} contains "Bob" or "bob" or "Bob":
		handleStoryNpc_bob({_p}, {_loc})
		stop
	
	if {_npcName} contains "Luna" or "luna" or "Luna":
		handleStoryNpc_luna({_p}, {_loc})
		stop
	

# ==============================================================================
#                         HANDLER DIALOG PER KARAKTER
# ==============================================================================

function handleStoryNpc_bob(p: player, loc: location):
	set {_uuid} to uuid of {_p}
	set {_stage} to {story::bob::%{_uuid}%::stage} ? "NOT_STARTED"
	storyClearDialogueQueue({_p})

	if {_stage} is "NOT_STARTED":
		storyQueueDialogue({_p}, "Bob", "Halo petualang! Selamat datang di ladang gandum timur.", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Bob", "Matahari hari ini cerah sekali, panen kali ini pasti melimpah!", "", 1.0, "bahagia")
		storyQueueDialogue({_p}, "Bob", "Hanya saja beberapa gagak nakal dari arah sumur tua suka mencuri benih...", "", 1.0, "sedih")
		storyQueueDialogue({_p}, "Bob", "Kalau kamu sempat ke sana, hati-hati ya, hawanya agak aneh akhir-akhir ini.", "", 1.0, "unique")
		storyStartDialogueQueue({_p}, "CALLBACK_BOB_INTRO", {_loc})

function handleStoryNpc_luna(p: player, loc: location):
	set {_uuid} to uuid of {_p}
	set {_stage} to {story::luna::%{_uuid}%::stage} ? "NOT_STARTED"
	storyClearDialogueQueue({_p})

	if {_stage} is "NOT_STARTED":
		storyQueueDialogue({_p}, "Luna", "Glek... glek... Haah, enaknya! Minuman di desa ini benar-benar juara!", "", 1.0, "bahagia")
		storyQueueDialogue({_p}, "Luna", "Syukurlah aku tidak salah jalan menempuh perjalanan jauh demi mencari pekerjaan.", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Luna", "AAAA!", "", 1.0, "unique")
		storyQueueDialogue({_p}, "Luna", "Duh, buih minumanku tumpah semua karena kamu mengagetkanku... :(", "", 1.0, "sedih")
		storyQueueDialogue({_p}, "Luna", "Eh? Tunggu dulu... Kamu orang sini?", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Luna", "Salam kenal! Namaku Luna, anak magang baru di tempat ini!", "", 1.0, "bahagia")
		storyQueueDialogue({_p}, "Luna", "Awalnya, kepala desa tiba-tiba saja mengubah bangunan ini menjadi sebuah tavern.", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Luna", "Karena aku sedang mencari lowongan pekerjaan sebagai staf quest atau staf guild...", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Luna", "Tanpa pikir panjang langsung ku-apply saja! Dan ta-da, sekarang aku terdampar di sini deh!", "", 1.0, "bahagia")
		storyQueueDialogue({_p}, "Luna", "Jadi, apa kamu mau mengambil quest, atau hanya ingin menemaniku minum?", "", 1.0, "biasa")
		storyStartDialogueQueue({_p}, "CALLBACK_LUNA_INTRO", {_loc})
	else if {_stage} is "Q1_ACTIVE":
		storyQueueDialogue({_p}, "Luna", "Sudah dapat gandumnya? Perutku mulai berbunyi dari tadi, haha...", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Luna", "Kumpulkan 10 Wheat segar dari ladang ya. Nanti kita olah bersama!", "", 1.0, "sedih")
		storyStartDialogueQueue({_p}, "", {_loc})
	else if {_stage} is "Q2_ACTIVE":
		storyQueueDialogue({_p}, "Luna", "Belum ketemu pohon apelnya? Ada di tebing sebelah barat desa.", "", 1.0, "biasa")
		storyQueueDialogue({_p}, "Luna", "Petik 5 Apple ranum ya. Aku sangat membutuhkan nutrisi segar.", "", 1.0, "sedih")
		storyStartDialogueQueue({_p}, "", {_loc})
	else if {_stage} is "Q3_INVESTIGATE":
		storyQueueDialogue({_p}, "Luna", "Berhati-hatilah di sekitar Sumur Tua itu.", "", 1.0, "sedih")
		storyQueueDialogue({_p}, "Luna", "Hawa dingin di sana tidak wajar. Segera mundur jika ada hal yang mengancam!", "", 1.0, "unique")
		storyStartDialogueQueue({_p}, "", {_loc})
